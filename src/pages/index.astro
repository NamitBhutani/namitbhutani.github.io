---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { Header } from "../components/Header";
import { ProjectCard } from "../components/ProjectCard";
import { ExperienceCard } from "../components/ExperienceCard";
import { ResearchCard } from "../components/ResearchCard";
import PublicationItem from "../components/PublicationItem.astro";
import { HugeiconsIcon } from "@hugeicons/react";
import {
    File01Icon,
    Mail01Icon,
    Mortarboard01Icon,
    GithubIcon,
    Linkedin02Icon,
} from "@hugeicons/core-free-icons";
import {
    profile,
    education,
    news,
    publications,
    research,
    experience,
    projects,
} from "../data/profile";

// Drop a square photo at public/headshot.jpg and it appears in the sidebar automatically.
const hasPhoto = fs.existsSync(path.join(process.cwd(), "public", "headshot.jpg"));
const edu = education[0];

const links = [
    profile.scholar && { href: profile.scholar, label: "Google Scholar", icon: Mortarboard01Icon },
    { href: `mailto:${profile.email}`, label: profile.email, icon: Mail01Icon },
    { href: "https://github.com/NamitBhutani", label: "GitHub", icon: GithubIcon },
    { href: "https://linkedin.com/in/namitbhutani", label: "LinkedIn", icon: Linkedin02Icon },
].filter(Boolean) as { href: string; label: string; icon: any }[];
---

<Layout>
    <Header client:load />

    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-10 py-8 lg:py-12 grid gap-8 lg:gap-12 lg:grid-cols-[18rem_1fr]">
        {/* SIDEBAR: who, status, links. Sticky on wide screens so the CV is always one click away. */}
        <aside class="lg:sticky lg:top-20 self-start">
            <div class="panel">
                <div class="panel-h" tabindex="0" aria-expanded="true">Profile</div>
                <div class="panel-b space-y-5">
                    {hasPhoto && (
                        <img
                            src="/headshot.jpg"
                            alt="Photo of Namit Bhutani"
                            class="w-28 lg:w-full aspect-square object-cover border border-border"
                        />
                    )}
                    <div>
                        <h1 class="text-3xl font-semibold tracking-tight leading-tight">{profile.name}</h1>
                        <p class="mt-2 flex items-start gap-2 text-sm text-muted-foreground">
                            <span class="mt-1.5 size-2 shrink-0 rounded-full bg-primary"></span>
                            {profile.status}
                        </p>
                    </div>

                    <a
                        href="/Namit_Bhutani_CV.pdf"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center gap-2 h-10 bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
                    >
                        <HugeiconsIcon icon={File01Icon} size={18} /> Curriculum Vitae
                    </a>

                    <ul class="space-y-2 text-sm">
                        {links.map((l) => (
                            <li>
                                <a
                                    href={l.href}
                                    target={l.href.startsWith("http") ? "_blank" : undefined}
                                    rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}
                                    class="flex items-center gap-2.5 text-muted-foreground hover:text-primary transition-colors break-all"
                                >
                                    <HugeiconsIcon icon={l.icon} size={16} className="shrink-0" />
                                    {l.label}
                                </a>
                            </li>
                        ))}
                    </ul>

                    <div class="border-t border-border pt-4 text-sm">
                        <a href={edu.url} target="_blank" rel="noopener noreferrer" class="font-medium hover:text-primary">{edu.school}</a>
                        <div class="mt-1 text-muted-foreground leading-snug">{edu.degree}</div>
                        <div class="mt-1 font-mono text-xs text-muted-foreground">{edu.period} · {edu.gpa}</div>
                    </div>
                </div>
            </div>
        </aside>

        {/* MAIN */}
        <main class="min-w-0 space-y-8">
            <section id="home" class="relative">
                <p class="pt-1 pb-2 text-lg md:text-xl leading-relaxed text-muted-foreground max-w-4xl">
                    I'm a final-year undergraduate at
                    <span class="text-foreground font-medium">BITS Pilani</span>
                    working on interactive graphics that brings rendering, simulation and modelling together,
                    through real-time and spectral rendering, inverse procedural modelling of captured scenes
                    and physics-based simulation, with GPU algorithms and machine learning. My first-author paper on
                    <a href="/photoelasticity" class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary">real-time spectral photoelasticity</a>,
                    with Prof. Tathagata Ray and Prof. Sumanta Pattanaik (UCF), was published at
                    <span class="text-foreground font-medium">Pacific Graphics 2026</span>.
                    Right now I'm at the
                    <span class="text-foreground font-medium">Dynamic Graphics Project lab, University of Toronto</span>,
                    working on structural editing of captured 3D scenes.
                    Through Google Summer of Code, I also shipped sculpting performance work in
                    <a href="https://www.blender.org/" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary">Blender</a>.
                </p>
            </section>


            <section id="news" class="panel">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">News</h2>
                <ul class="panel-b space-y-2.5">
                    {news.map((n) => (
                        <li class="grid grid-cols-[5.5rem_1fr] gap-3 text-sm leading-relaxed">
                            <span class="font-mono text-muted-foreground">{n.date}</span>
                            <span set:html={n.html} />
                        </li>
                    ))}
                </ul>
            </section>

            <section id="publications" class="panel">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Publications</h2>
                <div class="panel-b space-y-10">
                    {publications.map((p) => <PublicationItem pub={p} />)}
                </div>
            </section>

            <section id="research" class="panel">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Research</h2>
                <div class="panel-b space-y-8">
                    {research.map((r) => <ResearchCard {...r} />)}
                </div>
            </section>

            <section id="experience" class="panel">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Experience</h2>
                <div class="panel-b">
                    {experience.map((exp) => <ExperienceCard {...exp} />)}
                </div>
            </section>

            <section id="projects" class="panel">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Projects</h2>
                <div class="panel-b grid gap-5 md:grid-cols-2">
                    {projects.map((proj) => <ProjectCard {...proj} />)}
                </div>
            </section>

            <section id="contact" class="panel">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Get in touch</h2>
                <div class="panel-b">
                    <p class="leading-relaxed max-w-2xl">
                        Always happy to talk about graphics research, or about my application
                        for graduate programs starting in 2027.
                    </p>
                    <a
                        href={`mailto:${profile.email}`}
                        class="mt-4 inline-flex items-center gap-2 h-10 px-4 bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
                    >
                        <HugeiconsIcon icon={Mail01Icon} size={18} /> Email me
                    </a>
                </div>
            </section>

            <footer class="pt-2 pb-8 text-sm text-muted-foreground font-mono">
                &copy; 2026 {profile.name}
            </footer>
        </main>
    </div>
</Layout>
