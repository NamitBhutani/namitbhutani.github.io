---
import Layout from "../layouts/Layout.astro";
import { Header } from "../components/Header";
import { Viewport } from "../components/Viewport";
---

<Layout
    title="Playground | Namit Bhutani"
    description="Small live WebGL versions of my work: stress fringes, Gaussian-splat selection and a ray-marched noise terrain."
>
    <Header client:load />
    <main class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-10 py-8 lg:py-12 space-y-6">
        <div class="max-w-3xl">
            <h1 class="text-3xl font-semibold tracking-tight">Playground</h1>
            <p class="mt-2 text-muted-foreground leading-relaxed">
                Small live versions of my work, running in your browser with plain WebGL2.
                The research itself is on the <a href="/" class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary">home page</a>.
            </p>
        </div>
        <Viewport client:visible />
    </main>
</Layout>
