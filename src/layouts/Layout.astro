---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const site = "https://namitbhutani.github.io";
const {
    title = "Namit Bhutani | Computer Graphics",
    description = "Namit Bhutani: undergraduate researcher at BITS Pilani working across computer graphics: rendering, Gaussian splatting and GPU performance. Seeking MS/PhD positions for 2027.",
    image = "/og.jpg",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonical} />
        <meta name="generator" content={Astro.generator} />
        <meta name="author" content="Namit Bhutani" />
        <title>{title}</title>

        <!-- Link previews (email clients, LinkedIn, Slack, WhatsApp) -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <script is:inline>
            const getThemePreference = () => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                // The viewport look is dark by default; the toggle switches to paper.
                return "dark";
            };
            const isDark = getThemePreference() === "dark";
            document.documentElement.classList[isDark ? "add" : "remove"](
                "dark",
            );

            if (typeof localStorage !== "undefined") {
                const observer = new MutationObserver(() => {
                    const isDark =
                        document.documentElement.classList.contains("dark");
                    localStorage.setItem("theme", isDark ? "dark" : "light");
                });
                observer.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ["class"],
                });
            }
        </script>
    </head>

    <body class="font-sans antialiased bg-background text-foreground">
        <slot />
        <script is:inline>
            // Every panel header with the drop-down triangle collapses its panel.
            // Delegated, so it also covers panels rendered by React islands.
            (() => {
                const toggle = (h) => {
                    const panel = h.closest(".panel");
                    if (!panel) return;
                    const collapsed = panel.classList.toggle("collapsed");
                    h.setAttribute("aria-expanded", String(!collapsed));
                };
                document.addEventListener("click", (e) => {
                    const h = e.target.closest?.(".panel-h");
                    if (!h || e.target.closest("button, a, input, [role=tab]")) return;
                    toggle(h);
                });
                document.addEventListener("keydown", (e) => {
                    if (e.key !== "Enter" && e.key !== " ") return;
                    const h = e.target;
                    if (!(h instanceof Element) || !h.classList.contains("panel-h")) return;
                    e.preventDefault();
                    toggle(h);
                });
            })();
        </script>
    </body>
</html>
