---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { Header } from "../components/Header";
import { ProjectCard } from "../components/ProjectCard";
import { ExperienceCard } from "../components/ExperienceCard";
import { ResearchCard } from "../components/ResearchCard";
import { SocialLinks } from "../components/SocialLinks";
import PublicationItem from "../components/PublicationItem.astro";
import { buttonVariants } from "@/components/ui/button";
import { HugeiconsIcon } from "@hugeicons/react";
import { File01Icon, Mail01Icon, Mortarboard01Icon } from "@hugeicons/core-free-icons";
import { cn } from "@/lib/utils";
import {
    profile,
    education,
    news,
    publications,
    research,
    experience,
    projects,
} from "../data/profile";

// Drop a square photo at public/headshot.jpg and it appears in the hero automatically.
const hasPhoto = fs.existsSync(path.join(process.cwd(), "public", "headshot.jpg"));
const edu = education[0];
---

<Layout>
    <Header client:load />

    <main class="flex flex-col min-h-screen">
        <div class="w-full max-w-4xl mx-auto">
            {/* HERO */}
            <section
                id="home"
                class="px-4 sm:px-6 pt-10 pb-12 md:pt-16 md:pb-16 grid gap-8 md:grid-cols-[1fr_auto] items-start"
            >
                <div class="flex flex-col gap-5 min-w-0">
                    <div
                        class="inline-flex w-fit items-center gap-2 bg-primary/10 px-3 py-1 text-sm font-medium text-primary font-mono"
                    >
                        <span class="size-2 rounded-full bg-primary animate-pulse"></span>
                        {profile.status}
                    </div>

                    <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
                        {profile.name}
                    </h1>

                    <p class="text-lg text-muted-foreground leading-relaxed max-w-2xl">
                        I'm a final-year undergraduate at
                        <span class="text-foreground font-medium">BITS Pilani</span>
                        interested in computer graphics broadly. My
                        first-author paper on
                        <a href="/photoelasticity" class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary">real-time spectral photoelasticity</a>,
                        with Prof. Tathagata Ray and Prof. Sumanta Pattanaik (UCF), appears at
                        <span class="text-foreground font-medium">Pacific Graphics 2026</span>.
                        Right now I'm at the
                        <span class="text-foreground font-medium">Dynamic Graphics Project lab, University of Toronto</span>,
                        working on interactive Gaussian splatting.
                        Through Google Summer of Code, I also shipped sculpting performance
                        work in
                        <a href="https://www.blender.org/" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary">Blender</a>.
                        I enjoy problems where light, physics and GPU performance meet.
                    </p>

                    <div class="flex items-start gap-3 text-sm text-muted-foreground border-l-2 border-primary/40 pl-4 py-1">
                        <HugeiconsIcon icon={Mortarboard01Icon} size={20} className="text-primary shrink-0 mt-0.5" />
                        <div class="leading-relaxed">
                            <a href={edu.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-foreground hover:text-primary">{edu.school}</a>
                            <div>{edu.degree}</div>
                            <div class="font-mono text-xs mt-0.5">{edu.period} · {edu.gpa}</div>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-3 items-center mt-1">
                        <a href="/Namit_Bhutani_CV.pdf" target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: "default", size: "lg" }), "gap-2")}>
                            <HugeiconsIcon icon={File01Icon} size={18} /> CV
                        </a>
                        {profile.scholar && (
                            <a href={profile.scholar} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: "outline", size: "lg" }), "gap-2")}>
                                <HugeiconsIcon icon={Mortarboard01Icon} size={18} /> Google Scholar
                            </a>
                        )}
                        <a href={`mailto:${profile.email}`} class={cn(buttonVariants({ variant: "outline", size: "lg" }), "gap-2")}>
                            <HugeiconsIcon icon={Mail01Icon} size={18} /> {profile.email}
                        </a>
                        <SocialLinks client:load showEmail={false} />
                    </div>
                </div>

                {hasPhoto && (
                    <img
                        src="/headshot.jpg"
                        alt="Photo of Namit Bhutani"
                        class="order-first md:order-last size-28 md:size-40 rounded-full object-cover ring-4 ring-primary/15"
                    />
                )}
            </section>

            {/* NEWS */}
            <section id="news" class="px-4 sm:px-6 py-10 border-t">
                <h2 class="text-2xl font-bold mb-5 font-mono">News</h2>
                <ul class="space-y-2.5">
                    {news.map((n) => (
                        <li class="grid grid-cols-[5.5rem_1fr] gap-3 text-sm leading-relaxed">
                            <span class="font-mono text-muted-foreground">{n.date}</span>
                            <span set:html={n.html} />
                        </li>
                    ))}
                </ul>
            </section>

            {/* PUBLICATIONS */}
            <section id="publications" class="px-4 sm:px-6 py-12 border-t">
                <h2 class="text-2xl font-bold mb-8 font-mono">Publications</h2>
                <div class="space-y-10">
                    {publications.map((p) => <PublicationItem pub={p} />)}
                </div>
            </section>

            {/* RESEARCH */}
            <section id="research" class="px-4 sm:px-6 py-12 border-t">
                <h2 class="text-2xl font-bold mb-8 font-mono">Research</h2>
                <div class="grid gap-6 md:grid-cols-2">
                    {research.map((r) => <ResearchCard {...r} />)}
                </div>
            </section>

            {/* EXPERIENCE */}
            <section id="experience" class="px-4 sm:px-6 py-12 border-t">
                <h2 class="text-2xl font-bold mb-8 font-mono">Experience</h2>
                <div class="max-w-3xl">
                    {experience.map((exp) => <ExperienceCard {...exp} />)}
                </div>
            </section>

            {/* PROJECTS */}
            <section id="projects" class="px-4 sm:px-6 py-12 border-t">
                <h2 class="text-2xl font-bold mb-8 font-mono">Projects</h2>
                <div class="grid gap-6 md:grid-cols-2">
                    {projects.map((proj) => <ProjectCard {...proj} />)}
                </div>
            </section>

            {/* CONTACT */}
            <section id="contact" class="px-4 sm:px-6 py-12 border-t">
                <div class="bg-primary/10 p-6 md:p-8">
                    <h2 class="text-2xl font-bold font-mono">Get in touch</h2>
                    <p class="mt-3 leading-relaxed max-w-2xl">
                        Always happy to talk about graphics research, or about my application
                        for graduate programs starting in 2027.
                    </p>
                    <div class="mt-5 flex flex-wrap gap-3">
                        <a href={`mailto:${profile.email}`} class={cn(buttonVariants({ variant: "default", size: "lg" }), "gap-2")}>
                            <HugeiconsIcon icon={Mail01Icon} size={18} /> Email me
                        </a>
                        <a href="/Namit_Bhutani_CV.pdf" target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: "outline", size: "lg" }), "gap-2")}>
                            <HugeiconsIcon icon={File01Icon} size={18} /> CV
                        </a>
                    </div>
                </div>
            </section>
        </div>

        <footer class="border-t py-8 mt-auto">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row gap-4 justify-between items-center text-sm text-muted-foreground">
                <p>&copy; 2026 {profile.name}</p>
                <SocialLinks client:load />
            </div>
        </footer>
    </main>
</Layout>
