---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { Header } from "../components/Header";
import { ExperienceCard } from "../components/ExperienceCard";
import { ResearchCard } from "../components/ResearchCard";
import { LiveDemo } from "../components/LiveDemo";
import PublicationItem from "../components/PublicationItem.astro";
import { HugeiconsIcon } from "@hugeicons/react";
import {
    File01Icon,
    Mail01Icon,
    Mortarboard01Icon,
    GithubIcon,
    Linkedin02Icon,
} from "@hugeicons/core-free-icons";
import {
    profile,
    education,
    news,
    publications,
    research,
    experience,
    projects,
} from "../data/profile";
import { homeOutline as outline, itemId } from "../data/outline";

// Drop a square photo at public/headshot.jpg and it appears in the sidebar automatically.
const hasPhoto = fs.existsSync(path.join(process.cwd(), "public", "headshot.jpg"));
const edu = education[0];

const links = [
    profile.scholar && { href: profile.scholar, label: "Scholar", icon: Mortarboard01Icon },
    { href: "https://github.com/NamitBhutani", label: "GitHub", icon: GithubIcon },
    { href: "https://linkedin.com/in/namitbhutani", label: "LinkedIn", icon: Linkedin02Icon },
].filter(Boolean) as { href: string; label: string; icon: any }[];
---

<Layout>
    <Header client:load outliner />

    <div id="page-content" class="mx-auto w-full max-w-7xl xl:max-w-[88rem] 2xl:max-w-[100rem] px-4 sm:px-6 lg:px-10 xl:px-8 min-[90rem]:px-12 py-8 lg:py-14 grid gap-10 lg:gap-16 xl:gap-14 min-[90rem]:gap-20 2xl:gap-24 lg:grid-cols-[18rem_minmax(0,1fr)] xl:grid-cols-[18rem_minmax(0,1fr)_15rem] min-[90rem]:grid-cols-[18rem_minmax(0,1fr)_16rem]">
        {/* SIDEBAR: who, status, links. Sticky on wide screens tall enough to show all of it;
            elsewhere it scrolls away and the header keeps the CV one click away.
            id + data-pixelate-layer: Firefox's pixelated header draws each sidebar panel on its
            own (src/lib/pixelate.ts), since it misplaces sticky content inside a bigger copy. */}
        <aside class="self-start lg:top-20 lg:[@media(min-height:54rem)]:sticky">
            <div id="page-profile" data-pixelate-layer class="panel">
                <div class="panel-h" tabindex="0" aria-expanded="true">Profile</div>
                <div class="panel-b lg:px-5 space-y-4">
                    {/* Phones: photo beside the name, so the bio starts on the first screen.
                        Wide screens: the full-width photo, with the name under it. */}
                    <div class="flex items-center gap-4 lg:block">
                        {hasPhoto && (
                            <img
                                src="/headshot.jpg"
                                alt="Photo of Namit Bhutani"
                                class="size-24 lg:size-auto lg:w-full lg:aspect-square shrink-0 object-cover border border-border"
                            />
                        )}
                        <h1 class="text-2xl lg:text-3xl lg:mt-5 font-semibold tracking-tight leading-tight">{profile.name}</h1>
                    </div>
                    <p class="flex items-start gap-2 text-sm text-muted-foreground">
                        <span class="mt-1.5 size-2 shrink-0 rounded-full bg-primary"></span>
                        {profile.status}
                    </p>

                    <a
                        href="/Namit_Bhutani_CV.pdf"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center gap-2 h-10 bg-primary/10 text-primary ring-1 ring-inset ring-primary/35 font-medium hover:bg-primary/20 transition-colors"
                    >
                        <HugeiconsIcon icon={File01Icon} size={18} /> Curriculum Vitae
                    </a>

                    {/* Email in full, so it can be copied; the profiles on one line. */}
                    <div class="space-y-2 text-sm">
                        <a href={`mailto:${profile.email}`} class="flex items-center gap-2.5 text-muted-foreground hover:text-primary transition-colors break-all">
                            <HugeiconsIcon icon={Mail01Icon} size={16} className="shrink-0" />
                            {profile.email}
                        </a>
                        <ul class="flex flex-wrap gap-x-3 gap-y-1">
                            {links.map((l) => (
                                <li>
                                    <a
                                        href={l.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center gap-1 text-muted-foreground hover:text-primary transition-colors"
                                    >
                                        <HugeiconsIcon icon={l.icon} size={15} className="shrink-0" />
                                        {l.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="border-t border-border pt-4 text-sm">
                        <a href={edu.url} target="_blank" rel="noopener noreferrer" class="font-medium hover:text-primary">{edu.school}</a>
                        <div class="mt-1 text-muted-foreground leading-snug">{edu.degree}</div>
                        <div class="mt-1 font-mono text-xs text-muted-foreground">{edu.period} · {edu.gpa}</div>
                    </div>
                </div>
            </div>
        </aside>

        {/* MAIN */}
        <main id="page-main" data-pixelate-layer class="min-w-0 space-y-14 lg:space-y-16">
            <section id="home" class="relative">
                <p class="pt-1 pb-2 text-lg md:text-xl leading-relaxed text-foreground/85 dark:text-foreground/90 max-w-4xl">
                    I'm a final-year undergraduate at
                    <span class="text-foreground font-medium">BITS Pilani</span>
                    working on interactive graphics that brings rendering, simulation and modelling together,
                    through real-time and spectral rendering, inverse procedural modelling of captured scenes
                    and physics-based simulation, with GPU algorithms and machine learning. My first-author paper on
                    <a href="/photoelasticity" class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary">real-time spectral photoelasticity</a>,
                    with Prof. Tathagata Ray and Prof. Sumanta Pattanaik (UCF), was published at
                    <span class="text-foreground font-medium">Pacific Graphics 2026</span>.
                    Right now I'm at the
                    <span class="text-foreground font-medium">Dynamic Graphics Project lab, University of Toronto</span>,
                    working on structural editing of captured 3D scenes.
                    Through Google Summer of Code, I also shipped sculpting performance work in
                    <a href="https://www.blender.org/" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary">Blender</a>.
                </p>
            </section>


            <section id="publications" class="panel panel-open">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Publications <span class="panel-meta">{publications.length} papers</span></h2>
                <div class="panel-b space-y-10">
                    {publications.map((p) => <PublicationItem pub={p} id={itemId("publications", p.short)} />)}
                </div>
            </section>

            <section id="news" class="panel panel-open">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">News <span class="panel-meta">latest {news[0].date}</span></h2>
                <ul class="panel-b space-y-3">
                    {news.map((n) => (
                        <li class="grid grid-cols-[5.5rem_1fr] sm:grid-cols-[7rem_1fr] gap-4 sm:gap-8 text-sm leading-relaxed">
                            <span class="font-mono text-muted-foreground">{n.date}</span>
                            <span set:html={n.html} />
                        </li>
                    ))}
                </ul>
            </section>

            <section id="research" class="panel panel-open">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Research <span class="panel-meta">{research.length} roles</span></h2>
                <div class="panel-b space-y-12">
                    {research.map((r) => (
                        <div id={itemId("research", r.short)}>
                            <ResearchCard {...r} />
                            {r.demo && <LiveDemo client:visible scene={r.demo.scene} label={r.demo.label} />}
                            {r.video && (
                                <video
                                    class="mt-4 w-full border border-border"
                                    src={r.video}
                                    poster={r.poster}
                                    controls
                                    muted
                                    playsinline
                                    preload="metadata"
                                />
                            )}
                        </div>
                    ))}
                </div>
            </section>

            <section id="experience" class="panel panel-open">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Experience <span class="panel-meta">{experience.length} roles</span></h2>
                <div class="panel-b">
                    {experience.map((exp) => <ExperienceCard {...exp} id={itemId("experience", exp.short)} />)}
                </div>
            </section>

            <section id="projects" class="panel panel-open">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Projects <span class="panel-meta">{projects.length} repos</span></h2>
                <div class="panel-b">
                    <ul class="divide-y divide-border">
                        {projects.map((p) => (
                            <li id={itemId("projects", p.title)} class="grid gap-x-12 gap-y-1.5 py-5 first:pt-0 last:pb-0 sm:grid-cols-[1fr_auto]">
                                <div class="min-w-0">
                                    <h3 class="font-semibold">{p.title}</h3>
                                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{p.description}</p>
                                    <p class="mt-1.5 font-mono text-xs text-muted-foreground">{p.tags.join(" · ")}</p>
                                </div>
                                {p.github && (
                                    <a
                                        href={p.github}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="self-start justify-self-start inline-flex items-center gap-1.5 h-7 px-2.5 font-mono text-xs ring-1 ring-foreground/15 text-muted-foreground hover:ring-primary hover:text-primary transition-colors"
                                    >
                                        <HugeiconsIcon icon={GithubIcon} size={14} /> Code
                                    </a>
                                )}
                                {p.demo && (
                                    <div class="sm:col-span-2 -mt-1.5">
                                        <LiveDemo client:visible scene={p.demo.scene} label={p.demo.label} />
                                    </div>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            </section>

            <section id="contact" class="panel panel-open">
                <h2 class="panel-h" tabindex="0" aria-expanded="true">Get in touch</h2>
                <div class="panel-b">
                    <p class="leading-relaxed max-w-2xl">
                        Always happy to talk about graphics research, or about my application
                        for graduate programs starting in 2027.
                    </p>
                    <a
                        href={`mailto:${profile.email}`}
                        class="mt-4 inline-flex items-center gap-2 h-10 px-4 bg-primary/10 text-primary ring-1 ring-inset ring-primary/35 font-medium hover:bg-primary/20 transition-colors"
                    >
                        <HugeiconsIcon icon={Mail01Icon} size={18} /> Email me
                    </a>
                </div>
            </section>

            <footer class="pt-4 pb-8 text-sm text-muted-foreground font-mono">
                &copy; 2026 {profile.name}
            </footer>
        </main>

        {/* Right column, wide screens only (three columns need ~1280px). */}
        <aside class="hidden xl:block">
            {/* Outliner, top right like Blender's: the page as a scene tree. The section on
                screen is the selected row (src/lib/outliner.ts); a row jumps to its section. */}
            <div id="page-outliner" data-pixelate-layer class="panel panel-open flex flex-col sticky top-20 max-h-[calc(100dvh-6rem)]">
                <div class="panel-h shrink-0" tabindex="0" aria-expanded="true">Outliner</div>
                <nav aria-label="Page sections" class="min-h-0 overflow-y-auto pt-3 pb-2 text-sm">
                    <div class="flex items-center gap-2 h-9 text-[16px] text-muted-foreground">
                        <span aria-hidden="true" class="outliner-collection"></span>
                        Scene Collection
                    </div>
                    <ul class="ml-[0.3rem] border-l border-border">
                        {outline.map((o) => (
                            <li data-outline-section={o.id}>
                                <a href={`#${o.id}`} data-outline={o.id} class="outliner-row h-9 text-[16px]">
                                    {/* Expands to its entries while you're reading it. */}
                                    <span aria-hidden="true" class={o.children ? "outliner-twisty" : "w-2"}></span>
                                    <span aria-hidden="true" class="outliner-object"></span>
                                    <span class="flex-1 truncate">{o.label}</span>
                                    {o.count !== undefined && <span class="font-mono text-xs text-muted-foreground/70">{o.count}</span>}
                                </a>
                                {o.children && (
                                    <div class="outliner-children">
                                        <ul class="min-h-0 overflow-hidden ml-[1.6rem] border-l border-border">
                                            {o.children.map((c) => (
                                                <li>
                                                    <a href={`#${c.id}`} data-outline-item={c.id} class="outliner-row h-8 text-sm">
                                                        <span aria-hidden="true" class="outliner-object"></span>
                                                        <span class="flex-1 truncate">{c.label}</span>
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                )}
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
        </aside>
    </div>
</Layout>

<script>
    import { setupOutliner } from "../lib/outliner";
    setupOutliner();
</script>
